# Database Connection URL (PostgreSQL)
# DATABASE_URL should be the pooled connection URL in serverless production (e.g. pgBouncer or Prisma Accelerate)
DATABASE_URL="postgresql://username:password@localhost:5432/football_court?schema=public"
# DIRECT_URL is the direct (non-pooled) database URL used for schema migrations (npx prisma db push)
DIRECT_URL="postgresql://username:password@localhost:5432/football_court?schema=public"

# AI Inference Keys for Grading Hot Takes & Image Generation
# At least one key is recommended. OpenRouter is required for AI Trading Card image generation.
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_key_here"
GROQ_API_KEY="gsk_your_groq_api_key_here"
NVIDIA_API_KEY="nvapi-your_nvidia_api_key_here"

# Configurable Image Generation Settings (OpenRouter Only)
OPENROUTER_IMAGE_MODEL="black-forest-labs/flux.2-pro"

# Credentials/session authentication secrets
# Generate with: openssl rand -hex 32
# AUTH_SECRET signs HTTP-only session cookies (MUST be >=32 random bytes in production)
AUTH_SECRET="replace_with_32_random_bytes_openssl_rand_hex_32"
# AUTH_SALT is the per-user password hashing pepper (PBKDF2)
AUTH_SALT="replace_with_16_random_bytes_openssl_rand_hex_16"

# Google OAuth client ID for the custom Google sign-in flow
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Discord OAuth credentials (for Discord login — optional)
DISCORD_CLIENT_ID="your_discord_client_id"
DISCORD_CLIENT_SECRET="your_discord_client_secret"

# Facebook OAuth credentials (for Facebook login — optional)
FACEBOOK_CLIENT_ID="your_facebook_app_id"
FACEBOOK_CLIENT_SECRET="your_facebook_app_secret"

# App Settings
NODE_ENV="development"
PORT=3000

# Public site URL — used for OG image metadata and sitemap generation
# Set this to your deployed domain in production (e.g., https://ballknowledge.live)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
